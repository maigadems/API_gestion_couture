# Copier ce fichier en .env puis remplacer les valeurs (le .env n'est jamais versionné)

# Base de données, pour l'API lancée en local (le port est celui publié par docker compose)
DATABASE_URL=postgresql+psycopg://utilisateur:mdp_de_la_bd@localhost:5433/nom_de_la_bd

# Clé de signature des jetons JWT : une longue chaîne aléatoire
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=une-longue-chaine-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Conteneur PostgreSQL (docker compose) : mêmes valeurs que dans DATABASE_URL
POSTGRES_USER=utilisateur
POSTGRES_PASSWORD=mdp_de_la_bd
POSTGRES_DB=nom_de_la_bd

# Premier administrateur, créé par : python -m app.seed
ADMIN_EMAIL=admin@atelier.sn
ADMIN_PASSWORD=un-mot-de-passe-de-8-caracteres-minimum
ADMIN_NOM_COMPLET=Administrateur

# Facultatif : ports publiés sur votre machine par docker compose
# DB_PORT=5433
# API_PORT=8000
